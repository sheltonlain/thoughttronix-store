# Copy to .env to override defaults. The app runs fine with no .env at all.
# SECRET_KEY=generate-a-real-one-for-anything-beyond-a-laptop
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
# Link lifetimes in seconds: password reset (1 hour), email verification (3 days).
# PASSWORD_RESET_TIMEOUT=3600
# EMAIL_VERIFICATION_TIMEOUT=259200
